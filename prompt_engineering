CONSTRUCT = dictionary.construct[0]
LOGIC = "no"

# read in few shot and knowledge for constructs
construct_info = pd.read_csv(start.PROMPT_DIR + "constructs.csv")
construct_info = construct_info.set_index(construct_info["construct"])

# few shot = examples
example = {"meaning making": construct_info["example"]["meaning making"],
           "emotional invalidation": construct_info["example"]["emotional invalidation"],
           "negative core beliefs": construct_info["example"]["negative core beliefs"],
           "reflective functioning": construct_info["example"]["reflective functioning"]}

# knowledge = construct definitions
knowledge = {"meaning making": construct_info["definition"]["meaning making"],
             "emotional invalidation": construct_info["definition"]["emotional invalidation"],
             "negative core beliefs": construct_info["definition"]["negative core beliefs"],
             "reflective functioning": construct_info["definition"]["reflective functioning"]}

# prompt = persona + task + knowledge + shots + format + logic
# input = prompt + case
prompt = {"zero-shot": dictionary.task[TASK] + CONSTRUCT + "? " + dictionary.format[TASK] + dictionary.logic[LOGIC],
          "few-shot": dictionary.task[TASK] + CONSTRUCT + "? " + example[CONSTRUCT] + dictionary.format[TASK] + dictionary.logic[LOGIC],
          "chain": dictionary.task[TASK] + dictionary.format[TASK] + dictionary.logic["chain"], 
          "persona": dictionary.persona[PERSONA] + dictionary.task[TASK] + dictionary.format[TASK] + dictionary.logic[LOGIC], 
          "knowledge": dictionary.task[TASK] + knowledge[CONSTRUCT] + dictionary.format[TASK] + dictionary.logic[LOGIC],
          "tree": dictionary.persona["tree of thoughts"] + dictionary.task[TASK] + dictionary.format[TASK]}

# cases
data = pd.read_csv(start.DATA_DIR + "negative_core_beliefs_train_gold.csv")

for each_prompt in prompt:
    for case in data["text"]:
        input = each_prompt + case
        print(input)


