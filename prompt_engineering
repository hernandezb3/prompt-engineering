import math
import re
import pandas as pd
from langchain_ollama import OllamaLLM
from library import start, dictionary, fit


# PART 1: create the model
model_id = "llama3.2"
# create docker or apptainer container container (see read me for instructions)
# where the model is published
ollama_server_url = "http://localhost:11434"
# tell langchain which model is published where
llm = OllamaLLM(model = model_id, base_url = ollama_server_url)


# PART 2: create the input
TASK = "crisp"
PERSONA = "therapist persona"
CONSTRUCT = dictionary.construct[1] # 1 = negative core beliefs
LOGIC = "no"

# read in few shot and knowledge for constructs
construct_info = pd.read_csv(start.PROMPT_DIR + "constructs.csv")
construct_info = construct_info.set_index(construct_info["construct"])

# few shot = examples
example = {dictionary.construct[0]: construct_info["example"][dictionary.construct[0]],
           dictionary.construct[1]: construct_info["example"][dictionary.construct[1]],
           dictionary.construct[2]: construct_info["example"][dictionary.construct[2]],
           dictionary.construct[3]: construct_info["example"][dictionary.construct[3]]}

# knowledge = construct definitions
knowledge = {dictionary.construct[0]: construct_info["definition"][dictionary.construct[0]],
             dictionary.construct[1]: construct_info["definition"][dictionary.construct[1]],
             dictionary.construct[2]: construct_info["definition"][dictionary.construct[2]],
             dictionary.construct[3]: construct_info["definition"][dictionary.construct[3]]}

# prompt = persona + task + knowledge + shots + format + logic
# input = prompt + case
prompt = {"zero-shot": dictionary.task[TASK] + CONSTRUCT + "? " + dictionary.format[TASK] + dictionary.logic[LOGIC],
          "few-shot": dictionary.task[TASK] + CONSTRUCT + "? " + example[CONSTRUCT] + dictionary.format[TASK] + dictionary.logic[LOGIC],
          "chain": dictionary.task[TASK] + dictionary.format[TASK] + dictionary.logic["chain"], 
          "persona": dictionary.persona[PERSONA] + dictionary.task[TASK] + dictionary.format[TASK] + dictionary.logic[LOGIC], 
          "knowledge": dictionary.task[TASK] + knowledge[CONSTRUCT] + dictionary.format[TASK] + dictionary.logic[LOGIC],
          "tree": dictionary.persona["tree of thoughts"] + dictionary.task[TASK] + dictionary.format[TASK]}

# cases
data = pd.read_csv(start.DATA_DIR + "negative_core_beliefs_train_gold.csv")
# drop NA
data = data.dropna(subset = ["text"])

# PART 3: generate output
for each_prompt in prompt:
    for case in data["text"]:
        input = prompt[each_prompt] + ' Here is the text: "' + case + '"'
        print(input)